---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: ImageMetadata; alt: string; caption?: string; priority?: boolean; class?: string; name?: string }
const {src,alt,caption,priority=false,class:className='',name}=Astro.props;
// The lightbox opens a 4K rendition rather than the full-resolution original.
const large=await getImage({src,width:Math.min(src.width,3840),format:'webp',quality:85});
---
<figure class={className} style={name?`view-transition-name:${name}`:undefined}><a class="photo-open" href={large.src} data-photo data-caption={caption || alt} aria-label={`${alt} — 크게 보기`}><Image src={src} alt={alt} widths={[480,800,1200,1800]} sizes="(max-width: 767px) 100vw, 90vw" format="webp" loading={priority?'eager':'lazy'} fetchpriority={priority?'high':undefined}/></a>{caption&&<figcaption>{caption}</figcaption>}</figure>
