---
import '../styles/global.css';
import '../styles/typography.css';
import '../styles/editorial.css';
import '../styles/story-layouts.css';
import Lightbox from '../components/Lightbox.astro';
interface Props { title?: string; description?: string; progress?: boolean }
const { title = 'The Places We Carry', description = '사진과 문장으로 남기는 여행의 아카이브, ELSEWHERE.', progress = false } = Astro.props;
const links = [['/journal','JOURNAL'],['/places','PLACES'],['/archive','ARCHIVE'],['/about','ABOUT']];
---
<!doctype html><html lang="ko" data-typography="photobook"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><meta property="og:title" content={`${title} — ELSEWHERE.`}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta name="theme-color" content="#F6F3ED"/><link rel="icon" href="/favicon.svg"/><title>{title} — ELSEWHERE.</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600&amp;family=Noto+Serif+KR:wght@400;500&amp;display=swap"/>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.css"/></head><body>
<a class="skip" href="#main">본문으로 건너뛰기</a>
{progress&&<div class="read-progress" aria-hidden="true"></div>}
<header class="site-header" data-site-header><div class="shell site-header-inner"><a class="wordmark" href="/" aria-label="ELSEWHERE 홈">ELSEWHERE<span>.</span></a><nav class="desktop-nav" aria-label="주 메뉴">{links.map(([url,label],i)=><a href={url} aria-current={Astro.url.pathname.startsWith(url)?'page':undefined}><sup>0{i+1}</sup>{label}</a>)}</nav><details class="mobile-nav"><summary><span class="when-closed">메뉴</span><span class="when-open">닫기</span></summary><nav aria-label="모바일 메뉴">{links.map(([url,label],i)=><a href={url} aria-current={Astro.url.pathname.startsWith(url)?'page':undefined}><sup>0{i+1}</sup>{label}</a>)}<p>사진과 문장으로 남기는 여행의 아카이브.</p></nav></details></div></header>
<main id="main"><slot/></main>
<footer class="site-footer"><div class="shell"><div class="footer-top"><p class="footer-note">머물렀던 곳,<br/>오래 남을 장면들.</p><nav aria-label="하단 메뉴">{links.map(([url,label])=><a href={url}>{label}</a>)}</nav><a class="to-top" href="#main">처음으로 ↑</a></div><p class="footer-mark" aria-hidden="true">ELSEWHERE<span>.</span></p><div class="footer-bottom"><span>THE PLACES WE CARRY</span><span>© {new Date().getFullYear()} ELSEWHERE.</span></div></div></footer><Lightbox/>
<script>
 // Header steps aside while reading downward and returns on any upward scroll.
 const header=document.querySelector<HTMLElement>('[data-site-header]')!;let last=scrollY;
 addEventListener('scroll',()=>{const y=scrollY;header.dataset.scrolled=String(y>12);header.dataset.hidden=String(y>last&&y>240&&!header.querySelector('details[open]'));last=y;},{passive:true});
 const menu=header.querySelector<HTMLDetailsElement>('.mobile-nav')!;
 addEventListener('keydown',e=>{if(e.key==='Escape'&&menu.open){menu.open=false;menu.querySelector('summary')!.focus();}});
 menu.addEventListener('toggle',()=>{document.documentElement.classList.toggle('menu-open',menu.open);});
</script>
</body></html>
