---
import Base from '../layouts/Base.astro';import {publicTrips,dateLabel} from '../lib/trips';
const trips=await publicTrips();const years=[...new Set(trips.map(t=>t.data.tripStart.getFullYear()))];
---
<Base title="Archive"><div class="shell"><header class="page-heading"><p class="eyebrow">A CHRONOLOGY</p><h1>차곡차곡, 여행의 시간.</h1><p>여행이 시작된 날을 기준으로 모았습니다.</p></header>{years.map(year=><section class="archive-year"><h2>{year}</h2><div>{trips.filter(t=>t.data.tripStart.getFullYear()===year).map(t=><a class="archive-row" href={`/journal/${t.id}/`}><span>{dateLabel(t.data.tripStart)}</span><h3>{t.data.title}</h3><span>{t.data.regions.join(' · ')} ↗</span></a>)}</div></section>)}</div></Base>
