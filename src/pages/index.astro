---
import Base from '../layouts/Base.astro';
import Globe from '../components/Globe.astro';
import StoryCard from '../components/StoryCard.astro';
import {publicTrips} from '../lib/trips';
const trips=await publicTrips();
---
<Base><Globe/><div class="shell"><p class="home-intro">여행은 지나가지만, 어떤 장면은 오래 남습니다.<br/>사진과 짧은 문장으로 그곳의 시간을 모읍니다.</p><section id="selected-stories"><div class="section-heading"><h2 class="eyebrow">SELECTED STORIES</h2><a href="/journal/">모든 여행기 보기 ↗</a></div><div class="editorial-grid">{trips.map((trip,index)=><StoryCard trip={trip} index={index}/>)}</div></section><section class="places-teaser"><p class="eyebrow">A MAP OF MEMORIES</p><h2>다시 펼쳐 보고 싶은 곳들.</h2><a href="/places/">장소로 찾아보기 ↗</a><p class="subtle">현재 콘텐츠는 디자인 확인용 예시입니다.</p></section></div></Base>
