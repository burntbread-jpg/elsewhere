---
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import { Image } from 'astro:assets';
import {publicTrips,tripRangeLabel,continentSlug} from '../../lib/trips';
import {render} from 'astro:content';
export async function getStaticPaths(){return (await publicTrips()).map(trip=>({params:{slug:trip.id},props:{trip}}));}
const {trip}=Astro.props;const {Content}=await render(trip);const all=await publicTrips();
// Volumes follow the archive numbering when given, else count up from the earliest journey; "next" continues down the newest-first list and wraps.
const volume=String(trip.data.volume??all.length-all.findIndex(t=>t.id===trip.id)).padStart(3,'0');const next=all.length>1?all[(all.findIndex(t=>t.id===trip.id)+1)%all.length]:undefined;
const season=['WINTER','WINTER','SPRING','SPRING','SPRING','SUMMER','SUMMER','SUMMER','AUTUMN','AUTUMN','AUTUMN','WINTER'][trip.data.tripStart.getMonth()];
---
<Base title={trip.data.title} description={trip.data.summary} progress><article class="story"><header class="shell story-heading"><p class="eyebrow">VOL. {volume} / <a href={`/journal/?continent=${continentSlug(trip.data.continent)}`}>{trip.data.continent}</a> / {trip.data.country} / {season} {trip.data.tripStart.getFullYear()}</p><h1>{trip.data.title}</h1><p class="subtle">{trip.data.subtitle}</p><dl class="story-facts"><div><dt>DATE</dt><dd>{tripRangeLabel(trip)}</dd></div><div><dt>PLACE</dt><dd>{trip.data.regions.join(' · ')}</dd></div><div><dt>COUNTRY</dt><dd>{trip.data.country}</dd></div><div><dt>VOLUME</dt><dd>{volume}</dd></div></dl>{trip.data.sample&&<p class="sample-note">샘플 여행기 · 날짜와 장소는 예시이며 이미지는 직접 제작한 풍경 일러스트입니다. 실제 방문 경험을 서술하지 않습니다.</p>}</header><div class="shell story-cover"><Photo src={trip.data.cover} alt={trip.data.coverAlt} priority name={`cover-${trip.id}`}/></div><div class="story-body"><Content/></div>
<footer class="story-end"><div class="shell story-end-row"><p class="eyebrow">END OF VOL. {volume}</p><a href="/journal/">← 모든 여행기</a></div>{next&&<a class="next-journey" href={`/journal/${next.id}/`}><div class="shell next-journey-inner"><div class="next-copy"><p class="eyebrow">NEXT JOURNEY ↗</p><h2>{next.data.title}</h2><p class="meta">{next.data.tripStart.getFullYear()} / {next.data.regions.join(' · ')}</p></div><div class="next-cover" style={`view-transition-name:cover-${next.id}`}><Image src={next.data.cover} alt="" widths={[480,800,1200]} sizes="(max-width: 767px) 100vw, 50vw" format="webp" loading="lazy"/></div></div></a>}</footer></article></Base>
