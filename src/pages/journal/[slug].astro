---
import Base from '../../layouts/Base.astro';
import StoryArticle from '../../components/StoryArticle.astro';
import {publicTrips} from '../../lib/trips';
export async function getStaticPaths(){return (await publicTrips()).map(trip=>({params:{slug:trip.id},props:{trip}}));}
const {trip}=Astro.props;
---
<Base title={trip.data.title} description={trip.data.summary} progress><StoryArticle trip={trip}/></Base>
