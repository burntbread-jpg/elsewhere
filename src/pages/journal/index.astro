---
import Base from '../../layouts/Base.astro';
import StoryCard from '../../components/StoryCard.astro';
import {publicTrips} from '../../lib/trips';
const trips=await publicTrips();const years=[...new Set(trips.map(t=>t.data.tripStart.getFullYear()))];const places=[...new Set(trips.flatMap(t=>t.data.regions[0]))];
---
<Base title="Journal"><div class="shell"><div class="page-heading"><p class="eyebrow">THE JOURNAL <span class="page-count">({String(trips.length).padStart(2,"0")} STORIES)</span></p><h1>사진으로 남긴,<br/>여행의 장면들.</h1><p>시간이 지나도 다시 돌아가고 싶은 페이지.</p></div><form class="filters" role="search" aria-label="여행기 필터"><span>FILTER BY</span><label>연도 <select name="year"><option value="">모든 연도</option>{years.map(y=><option value={y}>{y}</option>)}</select></label><label>장소 <select name="place"><option value="">모든 장소</option>{places.map(p=><option>{p}</option>)}</select></label><button type="reset">초기화</button><span id="result-count" aria-live="polite"></span></form><div class="editorial-grid">{trips.map((trip,index)=><StoryCard trip={trip} index={index}/>)}</div><p id="empty-results" hidden>아직 기록이 없는 조합입니다. 다른 연도나 장소를 선택해 주세요.</p></div></Base>
<script>
const form=document.querySelector<HTMLFormElement>('.filters')!;const year=form.elements.namedItem('year') as HTMLSelectElement;const place=form.elements.namedItem('place') as HTMLSelectElement;
function update(fromUrl=false){if(fromUrl){const p=new URLSearchParams(location.search);year.value=p.get('year')||'';place.value=p.get('place')||'';}let count=0;document.querySelectorAll<HTMLElement>('[data-story]').forEach(card=>{card.hidden=!!((year.value&&card.dataset.year!==year.value)||(place.value&&card.dataset.place!==place.value));if(!card.hidden)count++;});document.querySelector('#result-count')!.textContent=`${count}개의 기록`;document.querySelector<HTMLElement>('#empty-results')!.hidden=count>0;}
form.addEventListener('change',()=>{const url=new URL(location.href);for(const [key,value] of [['year',year.value],['place',place.value]])value?url.searchParams.set(key,value):url.searchParams.delete(key);history.pushState({},'',url);update();});form.addEventListener('submit',e=>e.preventDefault());form.addEventListener('reset',e=>{e.preventDefault();year.value='';place.value='';history.pushState({},'',location.pathname);update();});window.addEventListener('popstate',()=>update(true));update(true);
</script>

